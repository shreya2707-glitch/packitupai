# Copy to .env  (cp .env.example .env)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: without a key the app uses template explanations instead of the LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: raises GitHub API limits and allows private repos
GITHUB_TOKEN=
# Optional: raises NVD rate limits (only used when OSV has no CVSS score)
NVD_API_KEY=
